# WhatsApp Notification Configuration
# Option 1: CallMeBot (Free, zero-signup, 30-second setup)
# 1. Add +34 644 44 24 99 to your phone contacts on WhatsApp.
# 2. Send: "I allow callmebot to send me messages"
# 3. CallMeBot will reply with your personal API Key.
WHATSAPP_PHONE="+36301234567"
CALLMEBOT_API_KEY="your_callmebot_api_key_here"

# Option 2: Twilio WhatsApp (Optional enterprise alternative)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
